--
-- REFRESH MATERIALIZED VIEW ... WHERE ...: is the source plan reused?
--
-- Rewriting and planning the source query on every refresh cost about a sixth
-- of a warm scope-1 refresh, almost all of it the planning.  The plan is
-- cached for that reason, and this is the gate on whether the cache does what
-- it claims.
--
-- It cannot be a timing test.  The effect is a few microseconds on a cell of
-- about 60, which a benchmark cannot resolve, and a cache that silently
-- re-plans every call would look the same as one that works.
--
-- Nor can it hook "we reused the cache entry", which is what the obvious
-- injection point would observe.  That is true even when GetCachedPlan()
-- re-plans underneath it, so it would be green against the bug it exists to
-- catch.
--
-- What it watches instead is plansource->gplan changing, which means a new
-- generic plan, plus num_custom_plans, which is a genuine build counter.  Not
-- num_generic_plans.  That one is incremented in the else arm of
-- GetCachedPlan's custom-or-not branch, so it counts every call that returns a
-- generic plan whether or not one was built, and a probe reading it can never
-- go green.  The first version of this file did exactly that.
--
-- Checked as a detector rather than assumed.  Against a build where the
-- plansource is created and dropped on every refresh, every refresh below
-- reports "notice triggered for injection point matview-where-source-planned"
-- and this file is red.
--
-- The probe is attached only after a warm-up.  A partial refresh replaces the
-- predicate's constants with parameters before deparsing it, so params is
-- never NULL here and choose_custom_plan() no longer short-circuits: plancache
-- builds five custom plans and one generic before it compares them and
-- settles.  Those builds are real and the probe correctly reports them.  So
-- "the plan is reused" is a claim about the steady state, and asserting it
-- without also asserting the number 5 in choose_custom_plan() means letting
-- the comparison finish unwatched and then demanding silence.
--
CREATE EXTENSION injection_points;
-- debug_discard_caches calls InvalidateSystemCachesExtended() at every
-- invalidation-acceptance point, which invalidates every saved plansource with
-- a non-empty relationOids.  A reuse assertion must go red under it.  Disabled
-- explicitly, the way syscache-update-pruned.spec does.
SET debug_discard_caches = 0;
CREATE TABLE mvsp_base (id int PRIMARY KEY, v int);
INSERT INTO mvsp_base SELECT g, g * 10 FROM generate_series(1, 5) g;
CREATE MATERIALIZED VIEW mvsp AS SELECT id, v FROM mvsp_base;
CREATE UNIQUE INDEX ON mvsp (id);
--
-- Part 1: a constant literal.
--
-- Let plancache make its choice, unwatched.
UPDATE mvsp_base SET v = 101 WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
SELECT injection_points_attach('matview-where-source-planned', 'notice');
 injection_points_attach 
-------------------------
 
(1 row)

-- Now the plan must be reused.  No notice may appear here.  This is the
-- assertion; everything above it is setup.
UPDATE mvsp_base SET v = 102 WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
UPDATE mvsp_base SET v = 103 WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
SELECT id, v FROM mvsp ORDER BY id;
 id |  v  
----+-----
  1 | 103
  2 |  20
  3 |  30
  4 |  40
  5 |  50
(5 rows)

--
-- Part 2: a base-table change must invalidate it.
--
-- This is the correctness half, and the reason plancache was chosen over
-- stashing a PlannedStmt: a plan that outlives the shape of what it reads is a
-- wrong answer, not a slow one.  The notice must come back.
ALTER TABLE mvsp_base ADD COLUMN filler int;
UPDATE mvsp_base SET v = 104 WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
NOTICE:  notice triggered for injection point matview-where-source-planned
SELECT injection_points_detach('matview-where-source-planned');
 injection_points_detach 
-------------------------
 
(1 row)

--
-- Part 3: a VARYING literal, which is the case part 1 deliberately was not.
--
-- The cache is keyed on the deparsed predicate, so "WHERE id = 1" and
-- "WHERE id = 2" used to be two different statements: a caller refreshing one
-- row at a time rebuilt the generated SQL, re-prepared both SPI plans and
-- rebuilt and re-planned the source query on every single call, which measured
-- 8x the cost of a refresh that hits.  Replacing the predicate's constants with
-- parameters makes those two one statement with different values, and the plan
-- is reused across them.
--
-- Settle again first: part 2 invalidated the entry, so the plansource below is
-- a new one with its own comparison to make.
UPDATE mvsp_base SET v = 201 WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 2;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 3;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 4;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 5;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 2;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 3;
SELECT injection_points_attach('matview-where-source-planned', 'notice');
 injection_points_attach 
-------------------------
 
(1 row)

-- Every one of these is a different literal, and none of them may re-plan.
-- Verified as a detector: against a build that leaves the constants alone all
-- five report "notice triggered for injection point
-- matview-where-source-planned", because each is then a different cache key and
-- gets a whole new plansource.
UPDATE mvsp_base SET v = 202 WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 1;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 2;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 3;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 4;
REFRESH MATERIALIZED VIEW CONCURRENTLY mvsp WHERE id = 5;
SELECT id, v FROM mvsp ORDER BY id;
 id |  v  
----+-----
  1 | 202
  2 |  20
  3 |  30
  4 |  40
  5 |  50
(5 rows)

SELECT injection_points_detach('matview-where-source-planned');
 injection_points_detach 
-------------------------
 
(1 row)

DROP MATERIALIZED VIEW mvsp;
DROP TABLE mvsp_base;
DROP EXTENSION injection_points;
