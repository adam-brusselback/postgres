-pg_stat_replication| SELECT s.pid,
-    s.usesysid,
-    u.rolname AS usename,
-    s.application_name,
-    s.client_addr,
-    s.client_hostname,
-    s.client_port,
-    s.backend_start,
-    s.backend_xmin,
