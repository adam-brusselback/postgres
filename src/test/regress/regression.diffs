-            WHEN (s.stakind1 = 3) THEN s.stanumbers1[1]
-            WHEN (s.stakind2 = 3) THEN s.stanumbers2[1]
-            WHEN (s.stakind3 = 3) THEN s.stanumbers3[1]
-            WHEN (s.stakind4 = 3) THEN s.stanumbers4[1]
-            WHEN (s.stakind5 = 3) THEN s.stanumbers5[1]
