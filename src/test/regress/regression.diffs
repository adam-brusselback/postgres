-             old.f2,
-             old.f4,
-             "new foo".f1,
-             "new foo".f2,
-             "new foo".f4
-         )
-  UPDATE foo SET f1 = (foo.f1 + 1)
-   RETURNING WITH (OLD AS o, NEW AS n) o.f1,
-     o.f2,
-     o.f4,
-     n.f1,
-     n.f2,
-     n.f4,
-     o.*::foo AS o,
-     n.*::foo AS n,
-     (o.f1 = n.f1),
-     (o.* = n.*),
-     ( SELECT (o.f2 = n.f2)),
