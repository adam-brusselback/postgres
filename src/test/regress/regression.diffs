diff -U3 /home/user/postgres/src/test/regress/expected/foreign_data.out /home/user/postgres/src/test/regress/results/foreign_data.out
--- /home/user/postgres/src/test/regress/expected/foreign_data.out	2026-07-29 17:00:57.481368081 +0000
+++ /home/user/postgres/src/test/regress/results/foreign_data.out	2026-08-02 00:48:05.773545521 +0000
