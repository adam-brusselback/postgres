-        CASE
-            WHEN (s.stakind1 = 1) THEN s.stanumbers1
-            WHEN (s.stakind2 = 1) THEN s.stanumbers2
-            WHEN (s.stakind3 = 1) THEN s.stanumbers3
-            WHEN (s.stakind4 = 1) THEN s.stanumbers4
-            WHEN (s.stakind5 = 1) THEN s.stanumbers5
