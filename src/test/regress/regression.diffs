-         Sort Key: (count(*))
-         ->  HashAggregate
-               Output: ((i % 2)), count(*), json_agg_strict(i)
-               Group Key: (i.i % 2)
-               ->  Function Scan on pg_catalog.generate_series i
-                     Output: (i % 2), i
-                     Function Call: generate_series(1, 3)
