-            WHEN ((stat.a).stakind2 = 6) THEN (stat.a).stavalues2
-            WHEN ((stat.a).stakind3 = 6) THEN (stat.a).stavalues3
-            WHEN ((stat.a).stakind4 = 6) THEN (stat.a).stavalues4
-            WHEN ((stat.a).stakind5 = 6) THEN (stat.a).stavalues5
