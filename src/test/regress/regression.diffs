-         Hash Cond: (s.sid = t_1.tid)
-         ->  Seq Scan on public.pa_source s
-               Output: s.sid, s.ctid
-         ->  Hash
-               Output: t_1.tid, t_1.tableoid, t_1.ctid
-               ->  Seq Scan on public.pa_targetp t_1
-                     Output: t_1.tid, t_1.tableoid, t_1.ctid
