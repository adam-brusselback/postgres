-        CASE
-            WHEN (s.stakind1 = 1) THEN s.stavalues1
-            WHEN (s.stakind2 = 1) THEN s.stavalues2
-            WHEN (s.stakind3 = 1) THEN s.stavalues3
-            WHEN (s.stakind4 = 1) THEN s.stavalues4
-            WHEN (s.stakind5 = 1) THEN s.stavalues5
