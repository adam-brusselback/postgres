-        delete from IFace where slotname = old.slotname;
-	insert into IFace (
-		    slotname,
-		    sysname,
-		    ifname,
-		    slotlink
-		) values (
-		    new.slotname,
-		    new.sysname,
-		    new.ifname,
-		    new.slotlink
-		);
-        return null;
-    end if;
-    return new;
