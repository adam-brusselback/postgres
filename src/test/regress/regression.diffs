-            WHEN (s.stakind2 = 2) THEN s.stavalues2
-            WHEN (s.stakind3 = 2) THEN s.stavalues3
-            WHEN (s.stakind4 = 2) THEN s.stavalues4
-            WHEN (s.stakind5 = 2) THEN s.stavalues5
-            ELSE NULL::anyarray
