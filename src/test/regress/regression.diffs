-            LABEL l1 PROPERTIES (ename AS elname),
-        e3_2 KEY (id_3, id_2_1, id_2_2)
-            SOURCE KEY (id_3) REFERENCES v3 (id)
-            DESTINATION KEY (id_2_1, id_2_2) REFERENCES v2 (id1, id2)
