-(1 row)
-
-SELECT dup(textrange('aaa', 'bbb'));
-              dup              
--------------------------------
- (aaa,"{aaa,bbb}","[aaa,bbb)")
-(1 row)
-
-DROP FUNCTION dup(f1 anycompatiblerange);
--- fails, no way to deduce outputs
