-BEGIN;
-INSERT INTO test_temp(a, b, cnt) VALUES (-2, '', 0);
-DROP TABLE test_temp;
-ROLLBACK;
-SELECT count(*), max(a) max_a, min(a) min_a, max(cnt) max_cnt FROM test_temp;
