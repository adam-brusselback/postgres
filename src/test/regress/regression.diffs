-DECLARE
-	retval RECORD;
-BEGIN
-	IF $1 > 10 THEN
-		SELECT INTO retval 5, 10, 15;
-		RETURN NEXT retval;
-		RETURN NEXT retval;
-	ELSE
-		SELECT INTO retval 50, 5::numeric, ''xxx''::text;
-		RETURN NEXT retval;
-		RETURN NEXT retval;
-	END IF;
-	RETURN;
-END;' language plpgsql;
