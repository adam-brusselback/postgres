-	JSON_QUERY(js, '$' WITH UNCONDITIONAL ARRAY WRAPPER) AS "with uncond",
-	JSON_QUERY(js, '$' WITH ARRAY WRAPPER) AS "with"
-FROM
-	(VALUES
-		(jsonb 'null'),
-		('12.3'),
