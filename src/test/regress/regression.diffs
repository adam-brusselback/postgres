---------------------------------------------
- Merge on public.pa_target t
-   ->  Hash Left Join
-         Output: s.sid, s.ctid, t.ctid
-         Inner Unique: true
-         Hash Cond: (s.sid = t.tid)
-         ->  Seq Scan on public.pa_source s
-               Output: s.sid, s.ctid
-         ->  Hash
-               Output: t.tid, t.ctid
-               ->  Result
-                     Output: t.tid, t.ctid
-                     Replaces: Scan on t
-                     One-Time Filter: false
