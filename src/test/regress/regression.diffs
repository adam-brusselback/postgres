-        CASE
-            WHEN ((stat.a).stakind1 = 6) THEN (stat.a).stanumbers1[1]
-            WHEN ((stat.a).stakind2 = 6) THEN (stat.a).stanumbers2[1]
-            WHEN ((stat.a).stakind3 = 6) THEN (stat.a).stanumbers3[1]
