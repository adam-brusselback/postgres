-ALTER PROPERTY GRAPH g1
-    ADD EDGE TABLES (
-        e2_1 KEY (id_2_1, id_2_2, id_1)
-            SOURCE KEY (id_2_1, id_2_2) REFERENCES v2 (id1, id2)
-            DESTINATION KEY (id_1) REFERENCES v1 (id)
