-with a as ( select id from (values (1), (2)) as v(id) ),
-     b as ( select max((select sum(id) from a)) as agg )
-select agg from b;
-                 QUERY PLAN                 
---------------------------------------------
- Aggregate
-   Output: max((InitPlan expr_1).col1)
-   InitPlan expr_1
-     ->  Aggregate
-           Output: sum("*VALUES*".column1)
-           ->  Values Scan on "*VALUES*"
-                 Output: "*VALUES*".column1
-   ->  Result
