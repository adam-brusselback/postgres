---
--- Test cases involving OUT parameters
---
-CREATE FUNCTION rngfunc(in f1 int, out f2 int)
-AS 'select $1+1' LANGUAGE sql;
-SELECT rngfunc(42);
- rngfunc 
----------
-      43
-(1 row)
-
-SELECT * FROM rngfunc(42);
- f2 
-----
- 43
-(1 row)
-
-SELECT * FROM rngfunc(42) AS p(x);
- x  
-----
- 43
-(1 row)
