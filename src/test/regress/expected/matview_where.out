 ARRAY(subquery)          scope=3  ok
(1 row)

SELECT sq_probe('row-constructor IN',   $$(id, gid) IN (SELECT f.id, f.gid FROM public.sq_fact f WHERE f.gid = 2)$$);
               sq_probe               
--------------------------------------
