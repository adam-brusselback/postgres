SELECT sq_probe('two subqueries AND/OR',$$EXISTS (SELECT 1 FROM public.sq_fact f WHERE f.id = sq_mv.id AND f.gid = 1) OR id IN (SELECT f.id FROM public.sq_fact f WHERE f.gid = 3)$$);
               sq_probe               
--------------------------------------
